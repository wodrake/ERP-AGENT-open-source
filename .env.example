# DeepSeek API Key（主对话、grader、联网搜索共用）
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# 可选：不填则使用 deepseek-flash；需使用 DeepSeek Responses API 的 web_search
WEB_SEARCH_MODEL=deepseek-flash
DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses
MONGODB_URI= #这里我使用的本地的mongdb，当然可以使用docker
ERP_BASE_URL=http://localhost:8081
MCP_SERVER_URL=http://localhost:9000
SANDBOX_IMAGE=python:3.11-slim

# ===== 三层记忆（HOT / WARM / COLD，均可不配，走默认值）=====
# 情节记忆在 WARM 层停留天数，超过后只在 COLD 按需检索
MEMORY_WARM_EPISODE_DAYS=7
# 情节记忆保留天数，过期后被遗忘（硬删除）
MEMORY_EPISODE_TTL_DAYS=90
# COLD 层单次检索返回条数
MEMORY_RETRIEVAL_K=5
# 每位用户最多保留的情节条数
MEMORY_MAX_EPISODES=200
# 是否向 Agent 暴露 read_memory / remember 工具
MEMORY_TOOLS_ENABLED=true
# 是否启用 LLM 抽取偏好（默认关闭，走零成本确定性规则）
MEMORY_LLM_EXTRACTION=false
# 审查路由：默认保留 DeepSeek；可选 jev（独立于主 Agent / Grader）
REVIEW_ROUTER_PROVIDER=deepseek
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
