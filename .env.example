# DeepSeek API Key（主对话、grader、联网搜索共用）
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# 可选：不填则使用 deepseek-flash；需使用 DeepSeek Responses API 的 web_search
WEB_SEARCH_MODEL=deepseek-flash
DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses
MONGODB_URI= #这里我使用的本地的mongdb，当然可以使用docker
ERP_BASE_URL=http://localhost:8081
MCP_SERVER_URL=http://localhost:9000
SANDBOX_IMAGE=python:3.11-slim

# ===== 三层记忆（HOT / WARM / COLD，均可不配，走默认值）=====
# 情节记忆在 WARM 层停留天数，超过后只在 COLD 按需检索
MEMORY_WARM_EPISODE_DAYS=7
# 情节记忆保留天数，过期后被遗忘（硬删除）
MEMORY_EPISODE_TTL_DAYS=90
# COLD 层单次检索返回条数
MEMORY_RETRIEVAL_K=5
# 每位用户最多保留的情节条数
MEMORY_MAX_EPISODES=200
# 是否向 Agent 暴露 read_memory / remember 工具
MEMORY_TOOLS_ENABLED=true
# 是否启用 LLM 抽取偏好（默认关闭，走零成本确定性规则）
MEMORY_LLM_EXTRACTION=false
# 审查路由：默认保留 DeepSeek；可选 jev（独立于主 Agent / Grader）
REVIEW_ROUTER_PROVIDER=deepseek
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# ===== R4 工程化基线（示例占位，不要提交真实密钥）=====
# docker：尝试容器沙箱；state：内存后端，CI 和 compose 默认使用，不挂 docker.sock
SANDBOX_BACKEND=state
# 默认 false。只有显式设为 true 时，Docker 不可用才会在宿主机执行命令
SANDBOX_ALLOW_LOCAL_FALLBACK=false
# MCP 工具数为 0 时，会话在该秒数后自动重建
MCP_DEGRADED_SESSION_TTL_SECONDS=60
# GET 超时重试的初始等待秒数，最多再试 2 次；写操作不使用
HTTP_GET_RETRY_BASE_SECONDS=0.2
# compose 里由编排注入；本地直跑可保持下面的地址
# ERP_BASE_URL=http://127.0.0.1:8081
# MCP_SERVER_URL=http://127.0.0.1:9000
# MONGODB_URI=mongodb://127.0.0.1:27017
ERP_LANGFUSE_ENABLED=false
# 留空则使用仓库内置 seccomp.json。进程会读取文件并把 JSON 交给 Docker，
# 不要求该路径在 dockerd 的文件系统里可见。
# SANDBOX_SECCOMP_PATH=
